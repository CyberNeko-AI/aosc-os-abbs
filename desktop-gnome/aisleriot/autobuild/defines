PKGNAME=aisleriot
PKGSEC=gnome
PKGDEP="guile gtk-3 librsvg libcanberra gconf hicolor-icon-theme dconf"
BUILDDEP="desktop-file-utils itstool"
PKGDES="Collection of over 80 Solitaire games"

ABTYPE=meson
MESON_AFTER=(
    '-Dbinreloc=false'
    '-Ddbg=false'
    '-Ddbgui=false'
    '-Ddefault_theme_format=svg-rsvg'
    '-Ddefault_theme=gnomangelo_bitmap.svgz'
    '-Ddocs=true'
    '-Dgconf=false'
    '-Dhelp_format=html'
    '-Dhelp_method=ghelp'
    '-Dsound=true'
    '-Dtheme_fixed=true'
    '-Dtheme_kde=false'
    '-Dtheme_pysol=true'
    '-Dtheme_pysol_path=/usr/share/PySolFC'
    '-Dtheme_svg_qtsvg=false'
    '-Dtheme_svg_rsvg=true'
)
