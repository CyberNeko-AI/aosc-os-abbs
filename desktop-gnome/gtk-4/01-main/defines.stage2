PKGNAME=gtk-4
PKGSEC=x11
PKGDEP="cairo colord cups dconf desktop-file-utils fontconfig \
        fribidi gdk-pixbuf glib graphene libpng libxkbcommon \
        harfbuzz iso-codes libcloudproviders libepoxy librsvg libtiff \
        libjpeg-turbo pango shared-mime-info tinysparql vulkan-loader \
        wayland x11-lib"
BUILDDEP="docutils gobject-introspection shaderc vulkan wayland-protocols"
PKGDES="GIMP toolkit version 4"

ABTYPE=meson

# FIXME: -Daccesskit=disabled, AccessKit support does not seem to be ready
# and requires an older version that no longer builds.
MESON_AFTER=(
    '-Dx11-backend=true'
    '-Dwayland-backend=true'
    '-Dbroadway-backend=true'
    '-Dmedia-gstreamer=disabled'
    '-Dprint-cups=enabled'
    '-Dvulkan=enabled'
    '-Dcloudproviders=enabled'
    '-Dsysprof=disabled'
    '-Dtracker=enabled'
    '-Dcolord=enabled'
    '-Df16c=enabled'
    '-Daccesskit=disabled'
    '-Ddocumentation=true'
    '-Dman-pages=true'
    '-Dintrospection=enabled'
    '-Ddocumentation=false'
    '-Dscreenshots=false'
    '-Dman-pages=true'
    '-Dbuild-demos=true'
    '-Dbuild-examples=true'
)

PKGBREAK="gtk-2<=2.24.32-3 gtk-3<=3.24.24-1"
PKGREP="gtk-2<=2.24.32-3 gtk-3<=3.24.24-1"

PKGEPOCH=1
