PKGNAME=libgee
PKGSEC=gnome
PKGDEP="glib"
BUILDDEP="gobject-introspection"
BUILDDEP__RETRO=""
BUILDDEP__ARMV4="${BUILDDEP_RETRO}"
BUILDDEP__ARMV6HF="${BUILDDEP_RETRO}"
BUILDDEP__ARMV7HF="${BUILDDEP__RETRO}"
BUILDDEP__I486="${BUILDDEP__RETRO}"
BUILDDEP__LOONGSON2F="${BUILDDEP__RETRO}"
BUILDDEP__POWERPC="${BUILDDEP_RETRO}"
BUILDDEP__PPC64="${BUILDDEP_RETRO}"
PKGDES="GObject collection library"

# FIXME: Valadoc is broken with libgee 0.20.x.
AUTOTOOLS_AFTER=(
    '--disable-doc'
    '--enable-introspection'
    '--disable-vala'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-introspection'
    '--disable-vala'
)
