PKGNAME=ros-jazzy-ros-environment
PKGSEC=ros
PKGDEP="ros-jazzy-ros-workspace"
BUILDDEP="ros-jazzy-ament-cmake-core"
PKGDES="The package provides the environment variables \`ROS_VERSION\` and \`ROS_DISTRO\`"

ABTYPE=cmakeninja
PREFIX="/opt/ros/jazzy"
ABSPLITDBG=0
NOSTATIC=0
CMAKE_AFTER=(
    "-DCMAKE_PREFIX_PATH=/opt/ros/jazzy"
    "-DBUILD_TESTING=OFF"
)
