PKGNAME=ros-jazzy-fastrtps
PKGSEC=ros
PKGDEP="ros-jazzy-ros-workspace ros-jazzy-fastcdr ros-jazzy-foonathan-memory-vendor openssl tinyxml2 python-3"
BUILDDEP="cmake asio"
PKGDES="*eprosima Fast DDS* (formerly Fast RTPS) is a C++ implementation of the DDS (Data Distribution Service) standard of the OMG (Object Management Group). eProsima Fast DDS implements the RTPS (Real Time Publish Subscribe) protocol, which provides publisher-subscriber communications over unreliable transports such as UDP, as defined and maintained by the Object Management Group (OMG) consortium. RTPS is also the wire interoperability protocol defined for the Data Distribution Service (DDS) standard. *eProsima Fast DDS* expose an API to access directly the RTPS protocol, giving the user full access to the protocol internals"

ABTYPE=cmakeninja
PREFIX="/opt/ros/jazzy"
ABSPLITDBG=0
NOSTATIC=0
CMAKE_AFTER=(
    "-DCMAKE_PREFIX_PATH=/opt/ros/jazzy"
    "-DBUILD_TESTING=OFF"
)
